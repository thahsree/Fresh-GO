# ========================================================
# FRESHGO BACKEND - PRODUCTION ENVIRONMENT TEMPLATE
# Copy this file to .env.production on your production server
# ========================================================

PORT=4000
NODE_ENV=production
APP_URL=https://api.freshgo.in
CORS_ORIGIN="https://freshgo.in,https://admin.freshgo.in,https://delivery.freshgo.in"

# --------------------------------------------------------
# Self-Hosted PostgreSQL Configuration (Docker)
# --------------------------------------------------------
POSTGRES_USER=freshgo_prod
POSTGRES_PASSWORD=generate_a_super_strong_password_here_123!
POSTGRES_DB=freshgo_prod_db

# Internal URLs used by Docker containers
# (Replace with your actual POSTGRES_USER and POSTGRES_PASSWORD)
DATABASE_URL="postgresql://freshgo_prod:generate_a_super_strong_password_here_123!@postgres:5432/freshgo_prod_db?schema=public"
DIRECT_URL="postgresql://freshgo_prod:generate_a_super_strong_password_here_123!@postgres:5432/freshgo_prod_db?schema=public"

# --------------------------------------------------------
# Self-Hosted Redis Configuration (Docker)
# --------------------------------------------------------
REDIS_URL=""
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TLS=false

# --------------------------------------------------------
# Security & JWT Tokens (Generate unique 64-char keys)
# --------------------------------------------------------
JWT_ACCESS_SECRET="generate_a_long_random_jwt_access_secret_for_production_2026"
JWT_REFRESH_SECRET="generate_a_long_random_jwt_refresh_secret_for_production_2026"
JWT_ACCESS_EXPIRATION="7d"
JWT_REFRESH_EXPIRATION="30d"

# --------------------------------------------------------
# Razorpay Production Keys
# --------------------------------------------------------
RAZORPAY_KEY_ID="rzp_live_your_live_key_id"
RAZORPAY_KEY_SECRET="your_live_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_live_webhook_secret"

# --------------------------------------------------------
# SMS / OTP Provider (MSG91 / Twilio)
# --------------------------------------------------------
SMS_PROVIDER="msg91"
MSG91_AUTH_KEY="your_msg91_live_auth_key"
MSG91_OTP_TEMPLATE_ID="your_live_template_id"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# --------------------------------------------------------
# Push Notifications (Firebase FCM)
# --------------------------------------------------------
FIREBASE_PROJECT_ID="freshgo-fcm"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@freshgo-fcm.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --------------------------------------------------------
# Object Storage (Cloudflare R2 / AWS S3)
# --------------------------------------------------------
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID="your_r2_access_key_id"
S3_SECRET_ACCESS_KEY="your_r2_secret_access_key"
S3_BUCKET_NAME="freshgo-assets"
S3_PUBLIC_DOMAIN="https://assets.freshgo.in"

# --------------------------------------------------------
# Maps & Operations
# --------------------------------------------------------
GOOGLE_MAPS_API_KEY="your_production_google_maps_key"
COD_CASH_LIMIT=2500
DISPATCH_TIMEOUT_SECONDS=45
STALE_ORDER_TIMEOUT_MINUTES=15
