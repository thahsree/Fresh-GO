# Server Configuration
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
CORS_ORIGIN=*

# PostgreSQL Database (Prisma / Supabase)
DATABASE_URL="postgresql://freshgo:freshgo_secure_pass@localhost:5432/freshgo_db?schema=public"
DIRECT_URL="postgresql://freshgo:freshgo_secure_pass@localhost:5432/freshgo_db?schema=public"

# Redis Configuration (Cache, Pub/Sub, BullMQ / Upstash)
# Use REDIS_URL (e.g. rediss://... for Upstash) OR separate host/port/password
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# JWT Secrets
JWT_ACCESS_SECRET="freshgo_super_secret_jwt_access_key_2026"
JWT_REFRESH_SECRET="freshgo_super_secret_jwt_refresh_key_2026"
JWT_ACCESS_EXPIRATION="7d"
JWT_REFRESH_EXPIRATION="30d"

# Razorpay Payment Gateway
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecretHere"

# SMS / OTP Provider (MSG91 / Twilio / Mock)
SMS_PROVIDER="mock" # "msg91" | "twilio" | "mock"
MSG91_AUTH_KEY="your_msg91_auth_key"
MSG91_OTP_TEMPLATE_ID="your_template_id"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Push Notifications (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID="freshgo-fcm"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@freshgo-fcm.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----"

# Cloudinary Image Storage (Recommended for hyper-fast media delivery & on-the-fly transformations)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Cloudflare R2 / AWS S3 Object Storage (Alternative)
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID="your_r2_access_key_id"
S3_SECRET_ACCESS_KEY="your_r2_secret_access_key"
S3_BUCKET_NAME="freshgo-assets"
S3_PUBLIC_DOMAIN="https://assets.freshgo.in"

# Online Payments Feature Flag ("false" = Cash on Delivery only, "true" = Razorpay enabled)
ONLINE_PAYMENTS_ENABLED="false"

# Google Maps Platform
GOOGLE_MAPS_API_KEY="AIzaSyYourGoogleMapsApiKey"

# Operational Limits
COD_CASH_LIMIT=2500
DISPATCH_TIMEOUT_SECONDS=45
STALE_ORDER_TIMEOUT_MINUTES=15

