{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "declaration": true,
    "types": [
      "react",
      "react-native"
    ],
    "paths": {
      "@fresh-food/design-tokens": [
        "../design-tokens/src"
      ]
    }
  },
  "include": [
    "src/**/*",
    "../design-tokens/src/**/*.ts"
  ]
}
