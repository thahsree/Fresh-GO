{
  "expo": {
    "name": "Fresh Go",
    "slug": "fresh-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/FreshGologonew.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow FreshGo to access your location to pinpoint your delivery address."
      }
    },
    "android": {
      "package": "com.freshgo.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow FreshGo to access your location to pinpoint your delivery address."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1ee809c0-0054-4b5c-8770-5dc8aafb4f05"
      }
    }
  }
}
